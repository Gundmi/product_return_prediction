/*
=============================================================================
RETURNSIGHT AI - Power BI DAX Measures Library
Project: Retail Product Return Prediction & Root-Cause Analytics
Platform Version: 1.0 Enterprise
Standard: Kimball Star Schema DAX Business Logic
=============================================================================
*/

// --- 1. CORE VOLUME & ACTUAL RETURN MEASURES ---

// Total Orders placed in the selected scope
Total Orders = 
COUNTROWS('FactOrders')

// Total actual confirmed returned orders
Actual Returns = 
CALCULATE(
    COUNTROWS('FactOrders'),
    'FactOrders'[ActualReturned] = 1
)

// Empirical observed return rate (Never calculated from model predictions)
Actual Return Rate = 
DIVIDE(
    [Actual Returns],
    [Total Orders],
    0
)

// Gross merchandise value (GMV) of all orders placed
Total Order Revenue = 
SUM('FactOrders'[ProductPrice])

// Revenue affected by confirmed product returns
Revenue Affected by Returns = 
CALCULATE(
    SUM('FactOrders'[ProductPrice]),
    'FactOrders'[ActualReturned] = 1
)

// Proportion of gross revenue affected by returns
Return Revenue Rate = 
DIVIDE(
    [Revenue Affected by Returns],
    [Total Order Revenue],
    0
)

// --- 2. PREDICTIVE & RISK MODEL MEASURES ---

// Average return probability scored by the ML champion model
Average Return Probability = 
AVERAGE('FactPredictions'[PredictedProbability])

// Total orders identified by the model as returns at decision threshold (0.35)
Predicted Returns = 
CALCULATE(
    COUNTROWS('FactPredictions'),
    'FactPredictions'[IsPredictedReturn] = 1
)

// Total orders categorised into High Risk tier (Probability >= 0.45)
High Risk Orders = 
CALCULATE(
    COUNTROWS('FactPredictions'),
    'FactPredictions'[RiskCategory] = "High Risk"
)

// Percentage of incoming volume classified as High Risk
High Risk Order Rate = 
DIVIDE(
    [High Risk Orders],
    [Total Orders],
    0
)

// Model Prediction Precision on Historical Actuals
Model Precision = 
VAR TruePositives = 
    CALCULATE(
        COUNTROWS('FactOrders'),
        'FactOrders'[ActualReturned] = 1,
        USERELATIONSHIP('FactOrders'[OrderID], 'FactPredictions'[OrderID]),
        'FactPredictions'[IsPredictedReturn] = 1
    )
RETURN 
    DIVIDE(TruePositives, [Predicted Returns], 0)

// --- 3. FINANCIAL LOSS & REVERSE LOGISTICS MEASURES ---

// Total direct reverse freight, inspection and restocking costs
Total Return Cost = 
SUM('FactReturnCosts'[ReturnCost])

// Average reverse logistics cost per returned order
Average Cost Per Return = 
DIVIDE(
    [Total Return Cost],
    [Actual Returns],
    0
)

// Total net profit margin erosion (Margin loss + reverse freight)
Total Profit Loss = 
SUM('FactReturnCosts'[NetProfitLoss])

// Potential financial savings achieved if return prevention actions reduce high-risk returns by 20%
Projected Cost Savings (20% Mitigation) = 
[Total Return Cost] * 0.20

// --- 4. SUSTAINABILITY & ESG METRICS ---

// Total carbon dioxide equivalent emissions generated by return transportation (kg CO2e)
Total CO2 Emissions (kg) = 
SUM('FactReturnCosts'[CO2EmissionsKg])

// Total cardboard and plastic packaging waste generated by returns (kg)
Total Packaging Waste (kg) = 
SUM('FactReturnCosts'[PackagingWasteKg])

// Projected carbon emissions avoided with 20% return prevention
Projected CO2 Avoided (kg) = 
[Total CO2 Emissions (kg)] * 0.20

// Projected packaging waste eliminated with 20% return prevention
Projected Packaging Waste Avoided (kg) = 
[Total Packaging Waste (kg)] * 0.20

// Equivalent mature trees required to absorb return emissions (EPA Factor: 21.77 kg/year)
Equivalent Trees Required = 
ROUND(DIVIDE([Total CO2 Emissions (kg)], 21.77, 0), 0)

// --- 5. LOGISTICS & SERVICE LEVEL METRICS ---

// Average days elapsed from delivery to return receipt at fulfillment hub
Average Days to Return = 
AVERAGE('FactReturns'[DaysToReturn])

// Average transit delivery delay across orders
Average Delivery Delay Days = 
AVERAGE('FactOrders'[DeliveryDelayDays])
